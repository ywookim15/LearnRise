# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser
# (safe by design); everything else is SERVER-ONLY — never prefix with NEXT_PUBLIC_.

# Supabase — Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys (Steps 3+): used exclusively inside API routes
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=
# Optional — video timestamps are skipped gracefully if absent
YOUTUBE_API_KEY=

# --- LLM providers (multi-provider split to spread rate limits) ---
# Planner (roadmap) -> Gemini; Curator -> Cerebras; Chief chat & Memory -> Groq.
GEMINI_API_KEY=
# (METIS_GEMINI_API_KEY overrides a conflicting shell GEMINI_API_KEY locally)
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional per-agent overrides (provider = gemini|groq|cerebras):
#   LLM_PLANNER_PROVIDER / LLM_PLANNER_MODEL
#   LLM_CURATOR_PROVIDER / LLM_CURATOR_MODEL
#   LLM_CHIEF_PROVIDER   / LLM_CHIEF_MODEL
#   LLM_MEMORY_PROVIDER  / LLM_MEMORY_MODEL
# Planner fallback if Gemini rate-limits (default: cerebras / gpt-oss-120b):
#   LLM_PLANNER_FALLBACK_PROVIDER / LLM_PLANNER_FALLBACK_MODEL
# Testing only: force a provider to rate-limit (comma list), e.g. "gemini".
#   LLM_FORCE_RATELIMIT=

# Stripe (TEST MODE). Publishable key is client-safe; the rest are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the dashboard webhook (deployed)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Resend (contact form email)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
