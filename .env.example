# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser
# (safe by design); everything else is SERVER-ONLY — never prefix with NEXT_PUBLIC_.

# Supabase — Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys (Steps 3+): used exclusively inside API routes
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
# Optional — video timestamps are skipped gracefully if absent
YOUTUBE_API_KEY=

# Stripe (TEST MODE). Publishable key is client-safe; the rest are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the dashboard webhook (deployed)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
